# ---------------------------------------------------------------- chain (web + worker)
NEXT_PUBLIC_MEZO_RPC_URL=https://rpc.test.mezo.org
NEXT_PUBLIC_MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
# From contracts/deployments/31611.json after `forge script Deploy`
NEXT_PUBLIC_MANAGER_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: adds WalletConnect to the Mezo Passport connect modal (cloud.reown.com project id)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------- database (web + worker)
# Unset → embedded PGlite at .data/pglite (single process only). Production: Neon/Supabase Postgres.
DATABASE_URL=

# ---------------------------------------------------------------- web
# >= 32 random chars (openssl rand -hex 32). Required in production.
SESSION_SECRET=
# 32-byte hex (openssl rand -hex 32). Encrypts recipient contact references at rest. Required in production.
RECIPIENT_DATA_KEY=
# Bearer token for POST /api/indexer/sync (cron fallback). Empty = endpoint disabled.
INDEXER_SECRET=
# Optional gas relayer for recipient claims. Gas-only hot wallet (holds a little BTC, never MUSD).
# Empty = recipients pay their own claim gas.
RELAYER_PRIVATE_KEY=
# Reference FX source for indicative quotes (keyless). Never hardcoded rates.
FX_REFERENCE_URL=https://open.er-api.com/v6/latest/USD
# Sandbox payout provider: HMAC secret for its simulated webhooks.
PROVIDER_WEBHOOK_SECRET_SANDBOX=
# Optional email (Resend). Empty = in-app notifications only.
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------- worker (Render)
CONFIRMATIONS=2
WORKER_INTERVAL_MS=10000
# RECONCILE_EVERY=20

# ---------------------------------------------------------------- scripts (never commit real keys)
DEPLOYER_PRIVATE_KEY=
SENDER_PRIVATE_KEY=
RECIPIENT_PRIVATE_KEY=

# ---------------------------------------------------------------- backend tuning (optional; defaults shown)
# Extra SIWE domains accepted in production besides NEXT_PUBLIC_APP_URL's host (comma-separated, e.g. a preview host).
# SIWE_EXTRA_DOMAINS=
# Fallback FX source (Frankfurter v2). Both sources failing → POST /api/quotes answers 503 rates_unavailable.
# FX_FALLBACK_URL=https://api.frankfurter.dev/v2/rates
# Blocks rewound when the indexer's cursor block hash no longer matches the chain.
# REORG_WINDOW=20
# Funding tx hint with no confirmed event after this many seconds → failed.
# FUNDING_TIMEOUT_SECONDS=1800
# Relayer is reported unavailable below this BTC balance (wei). Default: live gas price × 250k gas × 2.
# RELAYER_MIN_BALANCE_WEI=
# Sandbox (SIMULATED) payout timings + where the worker posts its signed webhooks.
# SANDBOX_PROCESSING_AFTER_SECONDS=10
# SANDBOX_COMPLETE_AFTER_SECONDS=30
# SANDBOX_WEBHOOK_URL=${NEXT_PUBLIC_APP_URL}/api/webhooks/sandbox
# Postgres pool size per process; local PGlite directory ("memory" = in-memory).
# DB_POOL_MAX=5
# Own Postgres schema when sharing a database with other apps (e.g. one Supabase project). Use the SESSION pooler
# (port 5432), not the transaction pooler, so the per-connection search_path holds.
# DB_SCHEMA=mezoremit
# PGLITE_DATA_DIR=.data/pglite
# Vercel Cron fallback: set CRON_SECRET to the same value as INDEXER_SECRET (Vercel sends it as a Bearer token).
# CRON_SECRET=

# ---------------------------------------------------------------- demo script (npm run demo:testnet)
# API_BASE_URL=http://localhost:3000
